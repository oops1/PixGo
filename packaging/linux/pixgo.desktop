[Desktop Entry]
Type=Application
Version=1.0
Name=PixGo
GenericName=Image Viewer
GenericName[ru]=Просмотр изображений
Comment=Fast and simple image viewer
Comment[ru]=Быстрый и простой просмотр изображений
